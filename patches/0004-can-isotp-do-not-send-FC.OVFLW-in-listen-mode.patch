From 17aa804da4728f5b3704cbeeb911589eecce7b48 Mon Sep 17 00:00:00 2001
From: Oliver Hartkopp <socketcan@hartkopp.net>
Date: Fri, 20 Nov 2026 21:10:39 +0000
Subject: [PATCH 04/23] can: isotp: do not send FC.OVFLW in listen mode

isotp_rcv_ff() sends a FC with overflow status when the FF_DL exceeds
the receive buffer before CAN_ISOTP_LISTEN_MODE is checked. So a socket
in listen mode, which is intended to monitor the ISO-TP traffic
passively, sends a FC.OVFLW on the bus when a received FF exceeds its
receive buffer (max_pdu_size). This aborts the transfer between other
nodes using the same CAN IDs.

Move the listen mode check from the callers into isotp_send_fc() before
any state changes to cover all FC frames.

Fixes: e057dd3fc20f ("can: add ISO 15765-2:2016 transport protocol")
Cc: stable@vger.kernel.org
Signed-off-by: Oliver Hartkopp <socketcan@hartkopp.net>
---
 net/can/isotp.c | 12 ++++--------
 1 file changed, 4 insertions(+), 8 deletions(-)

diff --git a/net/can/isotp.c b/net/can/isotp.c
index 3b83507..650d93e 100644
--- a/net/can/isotp.c
+++ b/net/can/isotp.c
@@ -294,6 +294,10 @@ static int isotp_send_fc(struct sock *sk, int ae, u8 flowstatus)
 	struct isotp_sock *so = isotp_sk(sk);
 	int can_send_ret;
 
+	/* no creation of flow control frames in listen mode */
+	if (so->opt.flags & CAN_ISOTP_LISTEN_MODE)
+		return 0;
+
 	nskb = alloc_skb(so->ll.mtu, gfp_any());
 	if (!nskb)
 		return 1;
@@ -643,10 +647,6 @@ static int isotp_rcv_ff(struct sock *sk, struct canfd_frame *cf, int ae)
 	hrtimer_start(&so->rxtimer, ktime_set(ISOTP_FC_TIMEOUT, 0),
 		      HRTIMER_MODE_REL_SOFT);
 
-	/* no creation of flow control frames */
-	if (so->opt.flags & CAN_ISOTP_LISTEN_MODE)
-		return 0;
-
 	/* send our first FC frame */
 	isotp_send_fc(sk, ae, ISOTP_FC_CTS);
 	return 0;
@@ -744,10 +744,6 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 	if (!so->rxfc.bs || ++so->rx.bs < so->rxfc.bs)
 		return 0;
 
-	/* no creation of flow control frames */
-	if (so->opt.flags & CAN_ISOTP_LISTEN_MODE)
-		return 0;
-
 	/* we reached the specified blocksize so->rxfc.bs */
 	isotp_send_fc(sk, ae, ISOTP_FC_CTS);
 	return 0;
