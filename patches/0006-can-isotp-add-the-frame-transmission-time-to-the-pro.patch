From f286a859209a34dd19ceb03c59987022c3d86ff7 Mon Sep 17 00:00:00 2001
From: Oliver Hartkopp <socketcan@hartkopp.net>
Date: Fri, 20 Nov 2026 13:13:51 +0000
Subject: [PATCH 06/23] can: isotp: add the frame transmission time to the
 protocol timeouts

The frame_txtime element of struct can_isotp_options is documented as
the frame transmission time (N_As/N_Ar). It is added to the gap between
the consecutive frames in the tx path, but it is missing when the
timeouts are started after the transmission of a CAN frame:

- isotp_send_fc() starts the rx timeout for the next consecutive frame
  without the transmission time of the flow control frame (N_Ar)
- isotp_sendmsg() starts the timeout for the first flow control frame
  without the transmission time of the first frame (N_As)

Add so->frame_txtime to both timeouts to comply with the documentation
in isotp.h. The local echo timeout for single frames and first frames
without flow control uses the same timer start in isotp_sendmsg() and
is extended by the frame transmission time as well.

ISO 15765-2 defines a timeout of 1000 ms for N_As/N_Ar, i.e. for the
transmission of a CAN frame on the sender and the receiver side. So far
frame_txtime accepted any value up to 0xFFFFFFFE ns (about 4.3 s). Reject
frame_txtime values above the N_As/N_Ar timeout of 1 s with -EINVAL
before the options are applied and document the limit in isotp.h and
iso15765-2.rst. Larger gaps between the consecutive frames can be
configured with the CAN_ISOTP_TX_STMIN socket option and the
CAN_ISOTP_FORCE_TXSTMIN flag.

There is no separate timer for N_As/N_Ar, as the frame transmission
time is covered by the protocol timeout that is started after the
transmission of the CAN frame.

Reported-by: Wentian Ye <yewentian395@gmail.com>
Closes: https://lore.kernel.org/linux-can/eb5e9618-3dbf-42cb-a635-752ff9fbcb99@hartkopp.net/
Signed-off-by: Oliver Hartkopp <socketcan@hartkopp.net>
---
 Documentation/networking/iso15765-2.rst | 12 ++++++++----
 include/uapi/linux/can/isotp.h          |  1 +
 net/can/isotp.c                         | 11 +++++++++--
 3 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/Documentation/networking/iso15765-2.rst b/Documentation/networking/iso15765-2.rst
index badcd16..1962209 100644
--- a/Documentation/networking/iso15765-2.rst
+++ b/Documentation/networking/iso15765-2.rst
@@ -208,10 +208,14 @@ where the ``can_isotp_options`` structure has the following contents:
   * ``CAN_ISOTP_DYN_FC_PARMS``: enable dynamic update of flow control
     parameters.
 
-* ``frame_txtime``: frame transmission time (defined as N_As/N_Ar inside the
-  ISO standard); if ``0``, the default (or the last set value) is used.
-  To set the transmission time to ``0``, the ``CAN_ISOTP_FRAME_TXTIME_ZERO``
-  macro (equal to 0xFFFFFFFF) shall be used.
+* ``frame_txtime``: frame transmission time in nanoseconds (defined as
+  N_As/N_Ar inside the ISO standard); if ``0``, the default (or the last set
+  value) is used. To set the transmission time to ``0``, the
+  ``CAN_ISOTP_FRAME_TXTIME_ZERO`` macro (equal to 0xFFFFFFFF) shall be used.
+  The frame transmission time is limited to the N_As/N_Ar timeout of 1 s
+  (1000000000 ns) defined in the ISO standard. It is added to the gap between
+  the consecutive frames and to the protocol timeouts that are started after
+  the transmission of a CAN frame.
 
 * ``ext_address``: extended addressing byte, used if the
   ``CAN_ISOTP_EXTEND_ADDR`` flag is specified.
diff --git a/include/uapi/linux/can/isotp.h b/include/uapi/linux/can/isotp.h
index bd99091..a2e5aa6 100644
--- a/include/uapi/linux/can/isotp.h
+++ b/include/uapi/linux/can/isotp.h
@@ -74,6 +74,7 @@ struct can_isotp_options {
 
 	__u32 frame_txtime;	/* frame transmission time (N_As/N_Ar)	*/
 				/* __u32 value : time in nano secs	*/
+				/* max. 1 s (N_As/N_Ar timeout)		*/
 
 	__u8  ext_address;	/* set address for extended addressing	*/
 				/* __u8 value : extended address	*/
diff --git a/net/can/isotp.c b/net/can/isotp.c
index 4320c31..8dd26a3 100644
--- a/net/can/isotp.c
+++ b/net/can/isotp.c
@@ -127,6 +127,7 @@ MODULE_PARM_DESC(max_pdu_size, "maximum isotp pdu size (default "
 
 #define ISOTP_FC_TIMEOUT 1	/* 1 sec */
 #define ISOTP_ECHO_TIMEOUT 2	/* 2 secs */
+#define ISOTP_MAX_FRAME_TXTIME_NS NSEC_PER_SEC /* N_As/N_Ar timeout */
 
 /* so->tx_result[so->tx_gen % ISOTP_TX_RESULT_SLOTS] holds the packed value
  * (err << ISOTP_TX_RESULT_GEN_BITS | gen) for each tx generation slot, so it
@@ -349,7 +350,8 @@ static int isotp_send_fc(struct sock *sk, int ae, u8 flowstatus)
 	so->lastrxcf_tstamp = ktime_set(0, 0);
 
 	/* start rx timeout watchdog */
-	hrtimer_start(&so->rxtimer, ktime_set(ISOTP_FC_TIMEOUT, 0),
+	hrtimer_start(&so->rxtimer,
+		      ktime_set(ISOTP_FC_TIMEOUT, so->frame_txtime),
 		      HRTIMER_MODE_REL_SOFT);
 	return 0;
 }
@@ -1333,7 +1335,7 @@ static int isotp_sendmsg(struct socket *sock, struct msghdr *msg, size_t size)
 	}
 	/* WAIT_FIRST_FC for standard FF, else stays ISOTP_SENDING */
 	WRITE_ONCE(so->tx.state, new_state);
-	hrtimer_start(tx_hrt, ktime_set(hrtimer_sec, 0),
+	hrtimer_start(tx_hrt, ktime_set(hrtimer_sec, so->frame_txtime),
 		      HRTIMER_MODE_REL_SOFT);
 	spin_unlock_bh(&so->rx_lock);
 
@@ -1751,6 +1753,11 @@ static int isotp_setsockopt_locked(struct socket *sock, int optname,
 		if (hweight32(opt->flags & ISOTP_ALL_BC_FLAGS) > 1)
 			return -EINVAL;
 
+		/* frame_txtime must not exceed the N_As/N_Ar timeout */
+		if (opt->frame_txtime != CAN_ISOTP_FRAME_TXTIME_ZERO &&
+		    opt->frame_txtime > ISOTP_MAX_FRAME_TXTIME_NS)
+			return -EINVAL;
+
 		memcpy(&so->opt, opt, sizeof(*opt));
 
 		/* no separate rx_ext_address is given => use ext_address */
-- 
