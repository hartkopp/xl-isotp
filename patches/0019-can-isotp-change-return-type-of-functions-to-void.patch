From 03092b3611d9fdf612f328b982b325d79b7a4765 Mon Sep 17 00:00:00 2001
From: Oliver Hartkopp <socketcan@hartkopp.net>
Date: Fri, 13 Feb 2026 13:41:26 +0100
Subject: [PATCH 19/23] can: isotp: change return type of functions to void

The return values of some functions have never been used and needed.
Make those functions void to remove unused return values.

Signed-off-by: Oliver Hartkopp <socketcan@hartkopp.net>
---
 net/can/isotp.c | 79 ++++++++++++++++++++++++++-----------------------
 1 file changed, 42 insertions(+), 37 deletions(-)

diff --git a/net/can/isotp.c b/net/can/isotp.c
index e6dd0b6..024d756 100644
--- a/net/can/isotp.c
+++ b/net/can/isotp.c
@@ -285,7 +285,7 @@ static enum hrtimer_restart isotp_rx_timer_handler(struct hrtimer *hrtimer)
 	return HRTIMER_NORESTART;
 }
 
-static int isotp_send_fc(struct sock *sk, int ae, u8 flowstatus)
+static void isotp_send_fc(struct sock *sk, int ae, u8 flowstatus)
 {
 	struct net_device *dev;
 	struct sk_buff *nskb;
@@ -296,18 +296,18 @@ static int isotp_send_fc(struct sock *sk, int ae, u8 flowstatus)
 
 	nskb = alloc_skb(so->ll.mtu, gfp_any());
 	if (!nskb)
-		return 1;
+		return;
 
 	csx = can_skb_ext_add(nskb);
 	if (!csx) {
 		kfree_skb(nskb);
-		return 1;
+		return;
 	}
 
 	dev = dev_get_by_index(sock_net(sk), so->ifindex);
 	if (!dev) {
 		kfree_skb(nskb);
-		return 1;
+		return;
 	}
 
 	csx->can_iif = dev->ifindex;
@@ -351,7 +351,8 @@ static int isotp_send_fc(struct sock *sk, int ae, u8 flowstatus)
 	/* start rx timeout watchdog */
 	hrtimer_start(&so->rxtimer, ktime_set(ISOTP_FC_TIMEOUT, 0),
 		      HRTIMER_MODE_REL_SOFT);
-	return 0;
+
+	return;
 }
 
 static void isotp_rcv_skb(struct sk_buff *skb, struct sock *sk)
@@ -441,14 +442,14 @@ static bool chk_pad_fail(struct isotp_sock *so, struct canfd_frame *cf,
 
 static void isotp_send_cframe(struct isotp_sock *so);
 
-static int isotp_rcv_fc(struct isotp_sock *so, struct canfd_frame *cf, int ae)
+static void isotp_rcv_fc(struct isotp_sock *so, struct canfd_frame *cf, int ae)
 {
 	struct sock *sk = &so->sk;
 	int tx_err = EBADMSG; /* default for unknown FC status */
 
 	if (READ_ONCE(so->tx.state) != ISOTP_WAIT_FC &&
 	    READ_ONCE(so->tx.state) != ISOTP_WAIT_FIRST_FC)
-		return 0;
+		return;
 
 	hrtimer_cancel(&so->txtimer);
 
@@ -457,7 +458,7 @@ static int isotp_rcv_fc(struct isotp_sock *so, struct canfd_frame *cf, int ae)
 	 */
 	if (READ_ONCE(so->tx.state) != ISOTP_WAIT_FC &&
 	    READ_ONCE(so->tx.state) != ISOTP_WAIT_FIRST_FC)
-		return 1;
+		return;
 
 	if ((cf->len < ae + FC_CONTENT_SZ) ||
 	    ((so->opt.flags & ISOTP_CHECK_PADDING) &&
@@ -471,7 +472,7 @@ static int isotp_rcv_fc(struct isotp_sock *so, struct canfd_frame *cf, int ae)
 		/* set to IDLE after publishing tx_result */
 		smp_store_release(&so->tx.state, ISOTP_IDLE);
 		wake_up_interruptible(&so->wait);
-		return 1;
+		return;
 	}
 
 	/* get static/dynamic communication params from first/every FC frame */
@@ -535,11 +536,12 @@ static int isotp_rcv_fc(struct isotp_sock *so, struct canfd_frame *cf, int ae)
 		smp_store_release(&so->tx.state, ISOTP_IDLE);
 		wake_up_interruptible(&so->wait);
 	}
-	return 0;
+
+	return;
 }
 
-static int isotp_rcv_sf(struct sock *sk, struct canfd_frame *cf, int pcilen,
-			struct sk_buff *skb, int len)
+static void isotp_rcv_sf(struct sock *sk, struct canfd_frame *cf, int pcilen,
+			 struct sk_buff *skb, int len)
 {
 	struct isotp_sock *so = isotp_sk(sk);
 	struct sk_buff *nskb;
@@ -548,7 +550,7 @@ static int isotp_rcv_sf(struct sock *sk, struct canfd_frame *cf, int pcilen,
 	WRITE_ONCE(so->rx.state, ISOTP_IDLE);
 
 	if (!len || len > cf->len - pcilen)
-		return 1;
+		return;
 
 	if ((so->opt.flags & ISOTP_CHECK_PADDING) &&
 	    chk_pad_fail(so, cf, pcilen + len, so->opt.rxpad_content)) {
@@ -556,22 +558,23 @@ static int isotp_rcv_sf(struct sock *sk, struct canfd_frame *cf, int pcilen,
 		sk->sk_err = EBADMSG;
 		if (!sock_flag(sk, SOCK_DEAD))
 			sk_error_report(sk);
-		return 1;
+		return;
 	}
 
 	nskb = alloc_skb(len, gfp_any());
 	if (!nskb)
-		return 1;
+		return;
 
 	memcpy(skb_put(nskb, len), &cf->data[pcilen], len);
 
 	nskb->tstamp = skb->tstamp;
 	nskb->dev = skb->dev;
 	isotp_rcv_skb(nskb, sk);
-	return 0;
+
+	return;
 }
 
-static int isotp_rcv_ff(struct sock *sk, struct canfd_frame *cf, int ae)
+static void isotp_rcv_ff(struct sock *sk, struct canfd_frame *cf, int ae)
 {
 	struct isotp_sock *so = isotp_sk(sk);
 	int i;
@@ -585,7 +588,7 @@ static int isotp_rcv_ff(struct sock *sk, struct canfd_frame *cf, int ae)
 
 	/* the first frame has to use the entire frame up to LL_DL length */
 	if (cf->len != so->rx.ll_dl)
-		return 1;
+		return;
 
 	/* get the FF_DL */
 	so->rx.len = (cf->data[ae] & 0x0F) << 8;
@@ -604,12 +607,12 @@ static int isotp_rcv_ff(struct sock *sk, struct canfd_frame *cf, int ae)
 
 		/* unneeded escape sequence => ignore PDU according to spec */
 		if (so->rx.len <= MAX_12BIT_PDU_SIZE)
-			return 1;
+			return;
 	}
 
 	/* single FF's are not allowed. rx.len has to require a CF */
 	if (so->rx.len + ae + ff_pci_sz <= so->rx.ll_dl)
-		return 1;
+		return;
 
 	/* PDU size > default => try max_pdu_size
 	 *
@@ -629,7 +632,7 @@ static int isotp_rcv_ff(struct sock *sk, struct canfd_frame *cf, int ae)
 	if (so->rx.len > so->rx.buflen) {
 		/* send FC frame with overflow status */
 		isotp_send_fc(sk, ae, ISOTP_FC_OVFLW);
-		return 1;
+		return;
 	}
 
 	/* copy the first received data bytes */
@@ -647,15 +650,16 @@ static int isotp_rcv_ff(struct sock *sk, struct canfd_frame *cf, int ae)
 
 	/* no creation of flow control frames */
 	if (so->opt.flags & CAN_ISOTP_LISTEN_MODE)
-		return 0;
+		return;
 
 	/* send our first FC frame */
 	isotp_send_fc(sk, ae, ISOTP_FC_CTS);
-	return 0;
+
+	return;
 }
 
-static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
-			struct sk_buff *skb)
+static void isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
+			 struct sk_buff *skb)
 {
 	struct isotp_sock *so = isotp_sk(sk);
 	struct sk_buff *nskb;
@@ -663,23 +667,23 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 
 	/* CFs are never longer than the FF */
 	if (cf->len > so->rx.ll_dl)
-		return 1;
+		return;
 
 	/* CFs have usually the LL_DL length */
 	if (cf->len < so->rx.ll_dl) {
 		/* this is only allowed for the last CF */
 		if (so->rx.len - so->rx.idx > so->rx.ll_dl - ae - N_PCI_SZ)
-			return 1;
+			return;
 	}
 
 	if (READ_ONCE(so->rx.state) != ISOTP_WAIT_DATA)
-		return 0;
+		return;
 
 	/* drop if timestamp gap is less than force_rx_stmin nano secs */
 	if (so->opt.flags & CAN_ISOTP_FORCE_RXSTMIN) {
 		if (ktime_to_ns(ktime_sub(skb->tstamp, so->lastrxcf_tstamp)) <
 		    so->force_rx_stmin)
-			return 0;
+			return;
 
 		so->lastrxcf_tstamp = skb->tstamp;
 	}
@@ -691,7 +695,7 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 	 * while hrtimer_cancel() above waited for it to finish => recheck
 	 */
 	if (READ_ONCE(so->rx.state) != ISOTP_WAIT_DATA)
-		return 1;
+		return;
 
 	if ((cf->data[ae] & 0x0F) != so->rx.sn) {
 		/* wrong sn detected - report 'illegal byte sequence' */
@@ -701,7 +705,7 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 
 		/* reset rx state */
 		WRITE_ONCE(so->rx.state, ISOTP_IDLE);
-		return 1;
+		return;
 	}
 	so->rx.sn++;
 	so->rx.sn %= 16;
@@ -722,12 +726,12 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 			sk->sk_err = EBADMSG;
 			if (!sock_flag(sk, SOCK_DEAD))
 				sk_error_report(sk);
-			return 1;
+			return;
 		}
 
 		nskb = alloc_skb(so->rx.len, gfp_any());
 		if (!nskb)
-			return 1;
+			return;
 
 		memcpy(skb_put(nskb, so->rx.len), so->rx.buf,
 		       so->rx.len);
@@ -735,7 +739,7 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 		nskb->tstamp = skb->tstamp;
 		nskb->dev = skb->dev;
 		isotp_rcv_skb(nskb, sk);
-		return 0;
+		return;
 	}
 
 	/* start rx timeout, isotp_send_fc() restarts it */
@@ -744,15 +748,16 @@ static int isotp_rcv_cf(struct sock *sk, struct canfd_frame *cf, int ae,
 
 	/* perform blocksize handling, if enabled */
 	if (!so->rxfc.bs || ++so->rx.bs < so->rxfc.bs)
-		return 0;
+		return;
 
 	/* no creation of flow control frames */
 	if (so->opt.flags & CAN_ISOTP_LISTEN_MODE)
-		return 0;
+		return;
 
 	/* we reached the specified blocksize so->rxfc.bs */
 	isotp_send_fc(sk, ae, ISOTP_FC_CTS);
-	return 0;
+
+	return;
 }
 
 static void isotp_rcv(struct sk_buff *skb, void *data)
