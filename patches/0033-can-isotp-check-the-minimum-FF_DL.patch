From 649ebecfbb6694bf0b2cf6bc6bcada979e8cc11e Mon Sep 17 00:00:00 2001
From: Oliver Hartkopp <socketcan@hartkopp.net>
Date: Fri, 20 Nov 2026 20:59:01 +0000
Subject: [PATCH 33/35] can: isotp: check the minimum FF_DL

ISO 15765-2 requires FF_DL >= FF_DLmin: a PDU that fits into a SF must
not be segmented. The single FF check only ensured that a CF is needed,
so for LL_DL 8 a FF_DL of 7 (6 with extended addressing) was accepted.

Check the FF_DL against the maximum SF_DL of the sender LL_DL like
isotp_sf_ff_pci() does on the tx path. For LL_DL > 8 this is the former
limit and 32 bit FF_DL values (> 4095) always exceed it.

Signed-off-by: Oliver Hartkopp <socketcan@hartkopp.net>
---
 net/can/isotp/protocolrx.c | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/net/can/isotp/protocolrx.c b/net/can/isotp/protocolrx.c
index 4d9063f..11a01d8 100644
--- a/net/can/isotp/protocolrx.c
+++ b/net/can/isotp/protocolrx.c
@@ -262,6 +262,7 @@ static void isotp_rcv_ff(struct sock *sk, u8 *data, unsigned int datalen)
 {
 	struct isotp_sock *so = isotp_sk(sk);
 	int ae = (so->opt.flags & CAN_ISOTP_EXTEND_ADDR) ? 1 : 0;
+	unsigned int sf_max;
 	int i;
 	int ff_pci_sz;
 
@@ -301,8 +302,13 @@ static void isotp_rcv_ff(struct sock *sk, u8 *data, unsigned int datalen)
 			return;
 	}
 
-	/* single FF's are not allowed. rx.len has to require a CF */
-	if (so->rx.len <= so->rx.ll_dl - ae - ff_pci_sz)
+	/* the PDU must not fit into a SF (FF_DLmin) */
+	if (so->rx.ll_dl == CAN_ISOTP_MIN_TX_DL)
+		sf_max = CAN_ISOTP_MIN_TX_DL - SF_PCI_SZ4 - ae;
+	else
+		sf_max = so->rx.ll_dl - SF_PCI_SZ11 - ae;
+
+	if (so->rx.len <= sf_max)
 		return;
 
 	/* PDU size > default => try max_pdu_size
